{
  "nodes": [
    {
      "id": "file:app/agent/graph.py",
      "type": "file",
      "name": "graph.py",
      "filePath": "app/agent/graph.py",
      "summary": "Assembles the LangGraph ReAct state graph (agent_node -> tools_node loop with checkpointer) and exposes high-level run_agent / stream_agent / resume_agent entrypoints that wire system-prompt context, RAG, memory, and profiling into each turn. This is the agent's brain.",
      "tags": ["langgraph", "react-graph", "orchestration", "entry-point", "agent-core"],
      "complexity": "complex",
      "languageNotes": "Uses a module-level compiled-graph singleton with async lazy initialization, fire-and-forget background tasks held by a strong-reference set to evade asyncio weak-ref GC, and LangGraph 1.2.x StreamWriter for token-level streaming."
    },
    {
      "id": "file:app/agent/nodes/agent_node.py",
      "type": "file",
      "name": "agent_node.py",
      "filePath": "app/agent/nodes/agent_node.py",
      "summary": "Core ReAct node that calls the LLM with token-level streaming, builds the chat request via the bridge, records GenAI spans, and returns an AIMessage (reply text or tool_calls) for the next graph step.",
      "tags": ["langgraph-node", "llm-streaming", "agent-core", "react"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/agent/nodes/bridge.py",
      "type": "file",
      "name": "bridge.py",
      "filePath": "app/agent/nodes/bridge.py",
      "summary": "Adapter translating LangChain AnyMessage objects into the project's unified ChatRequest/ChatMessage model, including tool definitions. The seam between LangGraph state and the multi-protocol LLM layer.",
      "tags": ["adapter", "message-conversion", "llm-abstraction", "langgraph"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/agent/nodes/tools_node.py",
      "type": "file",
      "name": "tools_node.py",
      "filePath": "app/agent/nodes/tools_node.py",
      "summary": "Executes tool_calls emitted by the agent node concurrently, enforcing risk-based human approval via LangGraph interrupt, emitting tool_start/tool_result stream events, and returning ToolMessages plus any plan state updates.",
      "tags": ["langgraph-node", "tool-execution", "human-in-loop", "approval", "agent-core"],
      "complexity": "complex"
    },
    {
      "id": "file:app/agent/plan.py",
      "type": "file",
      "name": "plan.py",
      "filePath": "app/agent/plan.py",
      "summary": "Task-planning layer exposing an update_plan tool that maintains a persisted multi-step plan (pending/in_progress/completed) as an external scratchpad for long ReAct runs, plus a StateUpdate return contract for tools.",
      "tags": ["task-planning", "tool", "state-update", "react"],
      "complexity": "moderate",
      "languageNotes": "Uses a LangChain @tool-decorated function and a dataclass return contract so the tools node can split a single return value into both a ToolMessage and a graph-state delta."
    },
    {
      "id": "file:app/agent/prompts/__init__.py",
      "type": "file",
      "name": "__init__.py",
      "filePath": "app/agent/prompts/__init__.py",
      "summary": "Default system-prompt template barrel holding the built-in SYSTEM_PROMPT constant (with a current_time placeholder), used as the fallback when no Hermes-evolved prompt version exists.",
      "tags": ["system-prompt", "barrel", "template", "constants"],
      "complexity": "simple"
    },
    {
      "id": "file:app/agent/state.py",
      "type": "file",
      "name": "state.py",
      "filePath": "app/agent/state.py",
      "summary": "Defines the AgentState TypedDict -- the LangGraph state schema -- with an add_messages reducer for conversation history and a custom replace_plan reducer for the task plan.",
      "tags": ["typeddict", "state-schema", "reducer", "langgraph"],
      "complexity": "simple",
      "languageNotes": "Uses typing.Annotated to attach reducers to TypedDict fields and NotRequired so legacy checkpoints without the plan field still deserialize."
    },
    {
      "id": "file:app/core/telemetry.py",
      "type": "file",
      "name": "telemetry.py",
      "filePath": "app/core/telemetry.py",
      "summary": "OpenTelemetry instrumentation: configures a TracerProvider with OTLP/Console exporters, auto-instruments FastAPI and httpx, and provides GenAI semantic-convention span helpers (llm_span, tool_span) used throughout the agent.",
      "tags": ["opentelemetry", "tracing", "genai-semconv", "instrumentation", "observability"],
      "complexity": "complex",
      "languageNotes": "Inlines GenAI semconv attribute strings (gen_ai.*) instead of importing the incubating semconv module, since the attribute names are stable but their Python module path shifts across OTel versions. Custom project attributes carry a selfagent.* prefix."
    },

