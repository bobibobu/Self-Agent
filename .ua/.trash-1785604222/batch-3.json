  "nodes": [
    {
      "id": "file:app/a2a/client.py",
      "type": "file",
      "name": "client.py",
      "filePath": "app/a2a/client.py",
      "summary": "A2A (Agent-to-Agent) protocol client that validates remote agent URLs against a configured allowlist with SSRF guard, then delegates messages via the A2A SDK and extracts text from responses.",
      "tags": ["a2a", "client", "agent-delegation", "ssrf-protection", "service"],
      "complexity": "moderate",
      "languageNotes": "Uses httpx.AsyncClient and the a2a-sdk (A2ACardResolver / A2AClient) for JSON-RPC style agent messaging."
    },
    {
      "id": "file:app/api/upload_routes.py",
      "type": "file",
      "name": "upload_routes.py",
      "filePath": "app/api/upload_routes.py",
      "summary": "FastAPI router for knowledge-base file uploads with extension/size validation, path-traversal-safe basename handling, async disk writes, and optional auto-ingest into the RAG service.",
      "tags": ["api-handler", "upload", "rag", "file-ingest", "router"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/core/config.py",
      "type": "file",
      "name": "config.py",
      "filePath": "app/core/config.py",
      "summary": "Central pydantic-settings configuration defining all environment-driven settings (LLM providers, Postgres/Mongo/Redis/Neo4j, MCP, A2A, JWT auth, rate-limit, sandbox, storage) with derived DSN properties and a cached get_settings accessor.",
      "tags": ["config", "settings", "pydantic", "service", "type-definition"],
      "complexity": "complex",
      "languageNotes": "A single Settings(BaseSettings) class holds ~70 fields; computed properties assemble async/sync Postgres DSNs and the Mongo/Redis URIs."
    },
    {
      "id": "file:app/main.py",
      "type": "file",
      "name": "main.py",
      "filePath": "app/main.py",
      "summary": "FastAPI application factory and wiring root: the lifespan context starts the DB pool, MCP client, tool registries, memory store, compiled agent graph and A2A mount, then mounts routers, exception handlers, rate-limit and metrics middleware, and OpenTelemetry.",
      "tags": ["entry-point", "fastapi", "lifespan", "wiring", "service"],
      "complexity": "complex",
      "languageNotes": "Implements the ASGI lifespan protocol (async generator) to orchestrate startup/shutdown of every subsystem; this is the uvicorn app.main:app target."
    },
    {
      "id": "file:app/mcp/client.py",
      "type": "file",
      "name": "client.py",
      "filePath": "app/mcp/client.py",
      "summary": "MCP (Model Context Protocol) client manager that loads server definitions from the configured JSON, connects through MultiServerMCPClient, and exposes the aggregated tool set.",
      "tags": ["mcp", "client", "tool-registry", "service", "integration"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/memory/checkpointer.py",
      "type": "file",
      "name": "checkpointer.py",
      "filePath": "app/memory/checkpointer.py",
      "summary": "LangGraph checkpointer factory selecting between SQLite, Postgres (AsyncPostgresSaver), and in-memory MemorySaver based on settings, with reset and persistence-status helpers used by observability and shutdown.",
      "tags": ["memory", "checkpointer", "langgraph", "persistence", "factory"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/memory/embeddings.py",
      "type": "file",
      "name": "embeddings.py",
      "filePath": "app/memory/embeddings.py",
      "summary": "Embedding layer providing async embedding (aembed) via OpenAI-compatible clients or a deterministic hash fallback, plus provider resolution, dimension config, and startup status logging.",
      "tags": ["embeddings", "memory", "rag", "openai", "factory"],
      "complexity": "moderate",
      "languageNotes": "Gracefully degrades to a locale-independent hash_embed when no embedding provider is configured so the store still works without an API key."
    },
    {
      "id": "file:app/memory/pg.py",
      "type": "file",
      "name": "pg.py",
      "filePath": "app/memory/pg.py",
      "summary": "Async Postgres connection pool (psycopg AsyncConnectionPool) singleton with lazy initialization, timeout-bounded open, and graceful shutdown used by the checkpointer and store.",
      "tags": ["postgres", "connection-pool", "psycopg", "memory", "service"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/memory/store.py",
      "type": "file",
      "name": "store.py",
      "filePath": "app/memory/store.py",
      "summary": "Long-term memory store built on LangChain AsyncPostgresStore / InMemoryStore, with per-user/tenant namespacing, vector index config, and a MemoryService facade exposing add/search/list/delete operations.",
      "tags": ["memory", "store", "langchain", "namespacing", "service"],
      "complexity": "moderate"
    },
    {
      "id": "file:app/rag/routes.py",
      "type": "file",
      "name": "routes.py",
      "filePath": "app/rag/routes.py",
