# ===================================================================
# Self-Agent 环境变量模板
# -------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 填入真实值（尤其是 LLM 的 API Key）
#   3. .env 已在 .gitignore 中，不会被提交
# ===================================================================

# ---------------- 应用 ----------------
APP_NAME=Self-Agent
APP_ENV=dev                      # dev / staging / prod
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                   # DEBUG / INFO / WARNING / ERROR

# ---------------- 链路追踪（OpenTelemetry）----------------
# 打开后每轮对话产出一棵 span 树：agent.turn → context.build / chat / execute_tool，
# 能直接看出「首字慢在检索还是慢在 LLM」「一个 turn 里调了几次模型」。
# infra/docker-compose.yml 里已带 Jaeger，UI: http://localhost:16686
OTEL_ENABLED=false
OTEL_SERVICE_NAME=self-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # 留空则 span 打到控制台
OTEL_CONSOLE_EXPORT=false
# ⚠️ 是否把 prompt/completion 正文写进 span。默认关闭——
#    正文可能含用户隐私、密钥、内部文档内容，别无意识地送去 trace 后端。
OTEL_CAPTURE_CONTENT=false

# ---------------- LLM 协议层 ----------------
# 默认使用哪个 provider： glm / openai / anthropic
LLM_DEFAULT_PROVIDER=glm

# --- GLM (智谱 / Z.AI) ---
# 走 OpenAI 兼容协议，base_url 固定，改 key 即可
# 国内： https://open.bigmodel.cn/api/paas/v4/
# 国际： https://api.z.ai/api/paas/v4/
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4.5-flash          # 免费档；旗舰可用 glm-4.6 / glm-5.2

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- LLM 调用超时与重试（交给各 SDK 内置机制，自带 429/5xx 指数退避）---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------- 向量化（长期记忆 / RAG 的语义检索）----------------
# auto = 跟随 LLM_DEFAULT_PROVIDER 自动选（有 key 才启用）
# ⚠️ 没有任何 embedding key 时会降级为哈希伪向量，检索结果无语义意义，
#    启动日志里会有明确 WARNING。生产务必配置。
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=                   # 留空用默认：glm=embedding-3 / openai=text-embedding-3-small
EMBEDDING_DIMS=                    # 留空用默认：glm=2048 / openai=1536

# ---------------- Agent ----------------
AGENT_RECURSION_LIMIT=25           # agent↔tools 循环上限（每个工具回合消耗 2 步）
TOOL_RESULT_MAX_CHARS=4000         # 单个工具结果注入上下文的最大字符数

# ---------------- 工作区与编码工具 ----------------
# 文件/Shell 工具的活动范围。留空 = 进程当前目录。
# 所有路径都被禁闭在此目录内，越界一律拒绝。
WORKSPACE_ROOT=
CODING_TOOLS_ENABLED=true          # 关掉则退化为纯问答机器人

# ⚠️ 工具审批策略——这是安全上最重要的一个开关：
#   gated    写文件与执行命令前询问用户（默认，推荐）
#   auto     全部直接执行（**仅限沙箱/CI**，别在自己机器上用）
#   strict   所有工具调用都询问
#   readonly 只允许只读工具，写与执行一律拒绝
TOOL_APPROVAL_MODE=gated
TOOL_AUTO_APPROVE=                 # 免审批的工具名单（逗号分隔）
SHELL_TIMEOUT_SECONDS=120
FILE_READ_MAX_BYTES=256000

# ---------------- 命令沙箱 ----------------
# 审批管「用户知不知情」，沙箱管「同意之后最多能造成多大破坏」，两者不可互相替代。
# 沙箱内：可写范围 = 工作区 + 私有临时目录；$HOME 不可见（~/.ssh ~/.aws 等凭据）。
#   auto      优先 bubblewrap，退到 Landlock，都没有则无隔离（并告警）
#   bwrap     namespace 隔离，文件系统 + 网络 + PID 全覆盖（最强）
#   landlock  内核原生 LSM，仅文件系统隔离，**不限制网络**
#   none      无隔离
SANDBOX_ENABLED=true
SANDBOX_BACKEND=auto
# 沙箱内是否允许联网。默认切断——防的是把代码/密钥 POST 出去。
# 需要 pip install / npm install 时再打开。
SANDBOX_ALLOW_NETWORK=false

# ---------------- PostgreSQL ----------------
# LangGraph 的短期记忆(checkpointer)与长期记忆(store)都落在这里
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=selfagent
POSTGRES_PASSWORD=selfagent123
POSTGRES_DB=selfagent

# ---------------- MongoDB ----------------
# 用于对话日志、原始事件、非结构化文档
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=selfagent
MONGO_PASSWORD=selfagent123
MONGO_DB=selfagent

# ---------------- Redis ----------------
# 缓存、限流、会话临时态
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------- Neo4j ----------------
# 用户画像与知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=selfagent123

# ---------------- 用户认证 ----------------
# Web 前端已带登录页，需要 AUTH_ENABLED=true 才有意义：
# 关闭时后端会忽略 token，把所有请求都当匿名用户，会话/记忆在用户之间共享。
# 仅在用 CLI 或裸 curl 调试时才关掉它。
AUTH_ENABLED=true
JWT_SECRET=CHANGE_ME_to_a_random_strong_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
# 管理员用户名（逗号分隔）。只有他们能调 /evolution/*、/metrics、
# 以及查看他人用量的 /stats/usage——这些接口能改写全局系统提示词。
ADMIN_USERNAMES=

# ---------------- 多租户 ----------------
MULTI_TENANT_ENABLED=false         # 开启后数据按 tenant_id 隔离
# 允许的租户 ID（逗号分隔）。开启多租户后，客户端通过 TENANT_HEADER
# 声明的租户必须在此名单内，否则拒绝——防止自助注册进他人租户。
TENANT_ALLOWLIST=
TENANT_HEADER=X-Tenant-Id

# ---------------- 限流 ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ---------------- 文件上传 ----------------
UPLOAD_DIR=data/uploads
UPLOAD_MAX_SIZE_MB=20

# ---------------- Hermes 自我进化 ----------------
HERMES_LEARNING_ENABLED=true
HERMES_REFLECTION_ENABLED=true
